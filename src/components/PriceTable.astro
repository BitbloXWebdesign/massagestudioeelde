---
import siteConfig from '../../public/site-config.json';

const waMessage = encodeURIComponent("Hallo Alianne, ik wil graag een afspraak maken bij Massage Studio Eelde.");
---

<div class="pricing-container">
  <!-- Regular Price Tables Grid -->
  <div class="price-tables-grid">
    <!-- Consulten & Therapeutisch (Vergoedbaar) -->
    <div class="price-card highlight-card">
      <div class="card-head">
        <span class="card-pill">Deels vergoed via aanvullende zorgverzekering</span>
        <h4 class="table-title">Therapeutische Consulten & Massages</h4>
        <p class="table-sub">Shiatsu therapie, Voetreflexologie, Dorn methode, Littekenbehandeling & Oorreflexologie</p>
      </div>

      <div class="price-rows">
        <div class="price-row">
          <div class="row-info">
            <strong>Intake + Eerste Consult (Reflex / Shiatsu / Dorn)</strong>
            <span>Eerste consult inclusief uitgebreide anamnese & gerichte behandeling</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;125,-</span>
            <span class="time">75 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Shiatsu Therapie / Massage</strong>
            <span>Drukpuntbehandeling en meridianen &bull; <em class="reimb-note">Deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Uitgebreide Behandeling Shiatsu / Massage</strong>
            <span>Diepgaande behandeling voor intensieve rust en herstel</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;125,-</span>
            <span class="time">75 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Voetreflextherapie</strong>
            <span>Reflexzones ter stimulatie van organen & drainage &bull; <em class="reimb-note">Deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Dorn-Methode</strong>
            <span>Milde correctie van wervelkolom en bekken &bull; <em class="reimb-note">Deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Littekenbehandeling</strong>
            <span>Zachte weefseltechnieken ter versoepeling &bull; <em class="reimb-note">Deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Oorreflexologie</strong>
            <span>Oorzonebehandeling voor pijndemping & zenuwstelsel &bull; <em class="reimb-note">Deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Zwangerschapsmassage</strong>
            <span>Verzorgend en klachtgericht &bull; <em class="reimb-cond">Als klachtgericht: deels vergoed</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Klassieke Ontspanningsmassage</strong>
            <span>Intensieve spierontspanning &bull; <em class="non-reimb-sub">Niet-vergoed (Wellness)</em></span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>
      </div>

      <div class="card-footer-cta">
        <a href={`https://wa.me/${siteConfig.whatsapp}?text=${waMessage}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full">
          Afspraak Maken via WhatsApp
        </a>
      </div>
    </div>

    <!-- BIOSLIMMING Prijzen (Niet vergoed) -->
    <div class="price-card">
      <div class="card-head">
        <span class="card-pill non-reimbursed">Niet vergoed door zorgverzekeraar</span>
        <h4 class="table-title">BIOSLIMMING Body Wrap Behandelingen</h4>
        <p class="table-sub">100% natuurlijke Multi-Award winnende afslank- en detoxbehandeling</p>
      </div>

      <div class="price-rows">
        <div class="price-row">
          <div class="row-info">
            <strong>Kennismakingsbehandeling Bioslimming</strong>
            <span>Inclusief intake, meting, body wrap en ontspanningsmoment</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;108,-</span>
            <span class="time">90 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Vervolgbehandeling Bioslimming</strong>
            <span>Losse vervolgsessie voor continue huidversteviging</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;132,-</span>
            <span class="time">60 min</span>
          </div>
        </div>

        <div class="price-row highlight-row">
          <div class="row-info">
            <strong>Kuur van 6 Behandelingen Bioslimming</strong>
            <span>Maximaal resultaat &bull; 1 behandeling per week gedurende 6 weken</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;648,-</span>
            <span class="time">6 weken</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Meerprijs Armen / Kuiten</strong>
            <span>Aanvullende zones tijdens een Bioslimming sessie</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;25,-</span>
            <span class="time">per zone</span>
          </div>
        </div>
      </div>

      <div class="non-reimbursed-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <p><strong>Let op:</strong> BIOSLIMMING behandelingen zijn cosmetisch/wellness van aard en vallen <u>niet</u> onder de vergoedbare zorg van de zorgverzekering.</p>
      </div>

      <div class="card-footer-cta">
        <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent("Hallo Alianne, ik wil graag informatie of een afspraak voor Bioslimming.")}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary w-full">
          Bioslimming Aanvragen
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .pricing-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .price-tables-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 960px) {
    .price-tables-grid {
      grid-template-columns: 1fr;
    }
  }

  .price-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .highlight-card {
    border-color: var(--secondary);
    background: linear-gradient(180deg, #ffffff 0%, var(--surface) 100%);
  }

  .card-head {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .card-pill {
    display: inline-block;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .card-pill.non-reimbursed {
    background: #fef2f2;
    color: #991b1b;
  }

  .table-title {
    font-size: 1.5rem;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }

  .table-sub {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .price-rows {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .price-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .highlight-row {
    background: var(--primary-light);
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--primary-subtle);
  }

  .row-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .row-info strong {
    font-size: 0.95rem;
    color: var(--text-color);
  }

  .row-info span {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .reimb-note {
    color: #15803d;
    font-weight: 600;
    font-style: normal;
  }

  .reimb-cond {
    color: #0369a1;
    font-weight: 600;
    font-style: normal;
  }

  .non-reimb-sub {
    color: #991b1b;
    font-weight: 600;
    font-style: normal;
  }

  .row-cost {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .cost {
    font-family: 'Unna', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1;
  }

  .time {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .non-reimbursed-box {
    background: #fdf2f8;
    border: 1px solid #fbcfe8;
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .non-reimbursed-box svg {
    color: #be185d;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .non-reimbursed-box p {
    font-size: 0.825rem;
    color: #831843;
    margin: 0;
    line-height: 1.45;
  }

  .card-footer-cta {
    margin-top: auto;
  }

  .w-full {
    width: 100%;
  }
</style>
