---
import siteConfig from '../../public/site-config.json';
---

<div class="pricing-container">
  <!-- Membership Highlight Box -->
  <div class="membership-box">
    <div class="membership-content">
      <span class="membership-badge">Aanbevolen Voordeel</span>
      <h3 class="membership-title">Massage Membership</h3>
      <p class="membership-sub">Voor regelmatige ontspanning en niet-vergoede behandelingen</p>
      
      <div class="membership-price-wrap">
        <span class="price-val">&euro;425</span>
        <span class="price-period">/ 6 behandelingen van 60 min</span>
      </div>

      <ul class="membership-features">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Voordeliger tarief:</strong> Aanzienlijk lagere kosten per massagebehandeling</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Volledige flexibiliteit:</strong> Plan uw behandelingen in op momenten die u uitkomen</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Prioriteit bij afspraken:</strong> Gegarandeerd snel terecht in de praktijk</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Duurzame ontspanning:</strong> Behoud van energie en effectieve stressverlaging</span>
        </li>
      </ul>
    </div>

    <div class="membership-action">
      <a href={siteConfig.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Lidmaatschap Aanvragen
      </a>
      <p class="action-note">Uiteraard kunt u ook altijd losse behandelingen boeken.</p>
    </div>
  </div>

  <!-- Regular Price Tables Grid -->
  <div class="price-tables-grid">
    <!-- Consulten & Therapeutisch -->
    <div class="price-card">
      <div class="card-head">
        <h4 class="table-title">Consulten & Therapeutische Behandelingen</h4>
        <p class="table-sub">Shiatsu therapie, Voetreflexologie, Dorn methode & Massage</p>
      </div>

      <div class="price-rows">
        <div class="price-row">
          <div class="row-info">
            <strong>Intake + Consult Reflextherapie of Shiatsu</strong>
            <span>Eerste consult inclusief uitgebreide anamnese & behandeling</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;125,-</span>
            <span class="time">75 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Shiatsu Therapie / Massage</strong>
            <span>Gerichte behandeling van klachten en meridiaanbanen</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Uitgebreide Behandeling Shiatsu / Massage</strong>
            <span>Diepgaande behandeling voor intensieve rust en herstel</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;125,-</span>
            <span class="time">75 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Voetreflextherapie</strong>
            <span>Reflexzonebehandeling ter stimulatie van orgaanfuncties</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Behandeling Oorreflexologie</strong>
            <span>Oorzonebehandeling gericht op pijndemping en stressreductie</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;80,-</span>
            <span class="time">50 min</span>
          </div>
        </div>
      </div>
    </div>

    <!-- BIOSLIMMING Prijzen -->
    <div class="price-card">
      <div class="card-head">
        <h4 class="table-title">BIOSLIMMING Body Wrap Behandelingen</h4>
        <p class="table-sub">100% natuurlijke Multi-Award winnende afslank- en detoxbehandeling</p>
      </div>

      <div class="price-rows">
        <div class="price-row">
          <div class="row-info">
            <strong>Kennismakingsbehandeling Bioslimming</strong>
            <span>Inclusief intake, meting, body wrap en ontspanningsmoment</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;108,-</span>
            <span class="time">90 min</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Vervolgbehandeling Bioslimming</strong>
            <span>Losse vervolgsessie voor continue huidversteviging</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;132,-</span>
            <span class="time">60 min</span>
          </div>
        </div>

        <div class="price-row highlight-row">
          <div class="row-info">
            <strong>Kuur van 6 Behandelingen Bioslimming</strong>
            <span>Maximaal resultaat &bull; 1 behandeling per week gedurende 6 weken</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;648,-</span>
            <span class="time">6 weken</span>
          </div>
        </div>

        <div class="price-row">
          <div class="row-info">
            <strong>Meerprijs Armen / Kuiten</strong>
            <span>Aanvullende zones tijdens een Bioslimming sessie</span>
          </div>
          <div class="row-cost">
            <span class="cost">&euro;25,-</span>
            <span class="time">per zone</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pricing-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .membership-box {
    background: linear-gradient(135deg, var(--surface) 0%, var(--primary-light) 100%);
    border: 2px solid var(--primary-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: center;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 900px) {
    .membership-box {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
  }

  .membership-badge {
    display: inline-block;
    background: var(--primary);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .membership-title {
    font-size: 2.2rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }

  .membership-sub {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .membership-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }

  .price-val {
    font-family: 'Unna', serif;
    font-size: 3.2rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1;
  }

  .price-period {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .membership-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .membership-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-color);
  }

  .membership-features svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .membership-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    background: #ffffff;
    padding: 2.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
  }

  .btn-lg {
    padding: 1rem 2.25rem;
    font-size: 1.05rem;
    width: 100%;
  }

  .action-note {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0;
  }

  .price-tables-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .price-tables-grid {
      grid-template-columns: 1fr;
    }
  }

  .price-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .card-head {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .table-title {
    font-size: 1.45rem;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }

  .table-sub {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .price-rows {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .price-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .highlight-row {
    background: var(--primary-light);
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--primary-subtle);
  }

  .row-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .row-info strong {
    font-size: 1rem;
    color: var(--text-color);
  }

  .row-info span {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .row-cost {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .cost {
    font-family: 'Unna', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1;
  }

  .time {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
