---
import siteConfig from '../../public/site-config.json';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}

const {
  title = `${siteConfig.clientName} | ${siteConfig.tagline}`,
  description = "Professionele praktijk voor therapeutische massages, Shiatsu, Voetreflexologie, Dorn methode, Littekenbehandeling en Bioslimming in Eelde-Paterswolde door erkend BATC therapeut Alianne Zuidhof-Hoiting.",
  canonicalUrl = Astro.url.href,
  image = "/images/MSE.png"
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HealthAndBeautyBusiness",
      "@id": "https://www.massagestudioeelde.nl/#business",
      "name": siteConfig.clientName,
      "alternateName": "Massage Studio Eelde - Alianne Zuidhof-Hoiting",
      "url": "https://www.massagestudioeelde.nl",
      "logo": "https://www.massagestudioeelde.nl/images/MSE.png",
      "image": "https://www.massagestudioeelde.nl/images/Alianne.webp",
      "description": description,
      "telephone": siteConfig.phone,
      "email": siteConfig.email,
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address.street,
        "addressLocality": "Eelde",
        "addressRegion": "Drenthe",
        "postalCode": siteConfig.address.postalCode,
        "addressCountry": "NL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 53.1364,
        "longitude": 6.5658
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Wednesday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "founder": {
        "@type": "Person",
        "name": siteConfig.therapistName,
        "jobTitle": "BATC Complementair Therapeut & Masseur",
        "memberOf": [
          {
            "@type": "Organization",
            "name": "BATC Beroepsorganisatie"
          },
          {
            "@type": "Organization",
            "name": "NAP Koepelorganisatie"
          }
        ]
      },
      "areaServed": siteConfig.regions.map(r => r.name).concat(["Assen", "Noord-Drenthe", "Groningen-Zuid"]),
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Massages en Complementaire Therapieën",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Shiatsu Therapie & Massage",
              "description": "Japanse drukpuntmassage voor het herstellen van de natuurlijke energiestroom en vermindering van spanningsklachten."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Dorn-Methode",
              "description": "Zachte, milde correctie van wervelkolom, bekken en beenlengteverschil in dynamische beweging."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Voetreflextherapie",
              "description": "Reflexzonebehandeling op de voeten voor orgaanstimulatie, lymfedrainage en diepe ontspanning."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Littekenbehandeling",
              "description": "Zachte bindweefseltechnieken om verkleefde littekens te versoepelen en doorbloeding te herstellen."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Oorreflexologie",
              "description": "Acupressuur op de oorschelp voor doelgerichte pijndemping en zenuwstelselregulatie."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Zwangerschapsmassage",
              "description": "Veilige en verzorgende massage voor aanstaande moeders, gericht op ontspanning of klachtenverlichting."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Klassieke Ontspanningsmassage",
              "description": "Intensieve spierontspanning en circulatieverbetering met warme olie."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "BIOSLIMMING Body Wrap Eelde",
              "description": "100% natuurlijke body wrap voor vetverbranding, cellulitisreductie en huidversteviging."
            }
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.massagestudioeelde.nl/#website",
      "url": "https://www.massagestudioeelde.nl",
      "name": siteConfig.clientName,
      "inLanguage": "nl-NL"
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
