---
import siteConfig from '../../public/site-config.json';

const isEnabled = siteConfig.modules.form || siteConfig.modules.contactForm;
const web3formsKey = siteConfig.web3formsAccessKey || "YOUR_WEB3FORMS_ACCESS_KEY";
---

{isEnabled && (
  <div class="contact-form-card">
    <div class="card-header">
      <h3 class="card-title">Stuur een Bericht of Stel een Vraag</h3>
      <p class="card-sub">Vul het formulier in en Alianne neemt binnen 1 werkdag contact met u op.</p>
    </div>

    <form id="mainContactForm" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
      <!-- Web3Forms Configuration -->
      <input type="hidden" name="access_key" value={web3formsKey} />
      <input type="hidden" name="subject" value="Nieuwe Contactaanvraag via Massage Studio Eelde Website" />
      <input type="hidden" name="from_name" value="Massage Studio Eelde Website" />
      
      <!-- Anti-Spam Honeypot -->
      <input type="checkbox" name="botcheck" class="hidden" style="display: none !important;" />

      <div class="form-row">
        <div class="form-group">
          <label for="contactName">Uw Naam *</label>
          <input type="text" id="contactName" name="name" required placeholder="Bijv. Sanne de Jong" class="form-input" />
        </div>
        <div class="form-group">
          <label for="contactEmail">E-mailadres *</label>
          <input type="email" id="contactEmail" name="email" required placeholder="sanne@voorbeeld.nl" class="form-input" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="contactPhone">Telefoonnummer</label>
          <input type="tel" id="contactPhone" name="phone" placeholder="06 - 12 34 56 78" class="form-input" />
        </div>
        <div class="form-group">
          <label for="contactService">Gewenste Behandeling</label>
          <select id="contactService" name="service" class="form-input form-select">
            <option value="Algemeen / Vraag over afspraak">Algemeen / Vraag over afspraak</option>
            <option value="Intake + Consult (75 min)">Intake + Consult (75 min)</option>
            <option value="Shiatsu therapie / massage (50 min)">Shiatsu therapie / massage (50 min)</option>
            <option value="Shiatsu therapie / massage (75 min)">Shiatsu therapie / massage (75 min)</option>
            <option value="Voetreflextherapie (50 min)">Voetreflextherapie (50 min)</option>
            <option value="Dorn-methode">Dorn-methode</option>
            <option value="Littekenbehandeling">Littekenbehandeling</option>
            <option value="Oorreflexologie">Oorreflexologie</option>
            <option value="Bioslimming behandeling">Bioslimming behandeling</option>
            <option value="Zwangerschapsmassage">Zwangerschapsmassage</option>
            <option value="Klassieke ontspanningsmassage">Klassieke ontspanningsmassage</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="contactMessage">Uw Bericht of Toelichting *</label>
        <textarea id="contactMessage" name="message" rows="5" required placeholder="Beschrijf eventuele klachten of geef uw voorkeursdagen aan..." class="form-input form-textarea"></textarea>
      </div>

      <div class="form-privacy-note">
        <label class="checkbox-label">
          <input type="checkbox" required />
          <span>Ik ga akkoord met de verwerking van mijn gegevens conform de <a href="/privacyverklaring">privacyverklaring</a> van Massage Studio Eelde.</span>
        </label>
      </div>

      <button type="submit" id="contactSubmitBtn" class="btn btn-primary btn-submit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <span id="submitBtnText">Verstuur Bericht</span>
      </button>

      <div id="contactFormStatus" class="form-status"></div>
    </form>
  </div>
)}

<style>
  .contact-form-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 640px) {
    .contact-form-card {
      padding: 1.75rem;
    }
  }

  .card-header {
    margin-bottom: 2rem;
  }

  .card-title {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .card-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-color);
  }

  .form-input {
    width: 100%;
    padding: 0.85rem 1.15rem;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text-color);
    background-color: var(--surface);
    transition: all 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(157, 70, 126, 0.12);
  }

  .form-select {
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-privacy-note {
    margin-top: -0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.825rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 3px;
    accent-color: var(--primary);
  }

  .checkbox-label a {
    text-decoration: underline;
  }

  .btn-submit {
    align-self: flex-start;
    padding: 0.9rem 2.25rem;
  }

  @media (max-width: 640px) {
    .btn-submit {
      width: 100%;
    }
  }

  .form-status {
    display: none;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 1rem;
    text-align: left;
  }

  .form-status.is-visible {
    display: block !important;
  }

  .form-status.success {
    background: #f0fdf4;
    color: #166534;
    border: 1.5px solid #86efac;
    box-shadow: 0 4px 12px rgba(22, 101, 52, 0.08);
  }

  .form-status.error {
    background: #fef2f2;
    color: #991b1b;
    border: 1.5px solid #fca5a5;
  }
</style>

<script>
  const form = document.getElementById('mainContactForm') as HTMLFormElement;
  const status = document.getElementById('contactFormStatus');
  const submitBtn = document.getElementById('contactSubmitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('submitBtnText');

  if (form && status && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      btnText.textContent = 'Verzenden...';
      submitBtn.disabled = true;
      status.className = 'form-status';
      status.style.display = 'none';

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        });

        const result = await response.json();

        status.style.display = 'block';
        if (response.status === 200 || result.success) {
          status.className = 'form-status success is-visible';
          status.innerHTML = '<strong>✓ Hartelijk dank voor uw bericht!</strong><br />Uw bericht is succesvol verzonden. Alianne neemt binnen 1 werkdag contact met u op.';
          form.reset();
          status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          throw new Error(result.message || 'Verzending mislukt');
        }
      } catch (err: any) {
        status.style.display = 'block';
        status.className = 'form-status error is-visible';
        status.innerHTML = `Er ging helaas iets mis bij het automatisch verzenden (${err.message || 'probeer opnieuw'}). U kunt ook direct mailen naar <a href="mailto:info@massagestudioeelde.nl" style="color: #991b1b; font-weight: 700; text-decoration: underline;">info@massagestudioeelde.nl</a> of appen via WhatsApp.`;
      } finally {
        btnText.textContent = 'Verstuur Bericht';
        submitBtn.disabled = false;
      }
    });
  }
</script>
