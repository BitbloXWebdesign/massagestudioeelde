---
interface Props {
  title?: string;
  badge?: string;
  points: {
    term: string;
    description: string;
  }[];
}

const { 
  title = "In het kort: Kernpunten van deze pagina", 
  badge = "Snelle Samenvatting", 
  points = [] 
} = Astro.props;
---

<aside class="ai-summary-box" aria-label="Overzicht en kernpunten">
  <div class="summary-header">
    <span class="summary-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      {badge}
    </span>
    <h3 class="summary-title">{title}</h3>
  </div>

  <div class="summary-grid">
    {points.map((pt) => (
      <div class="summary-item">
        <strong class="summary-term">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {pt.term}
        </strong>
        <p class="summary-desc">{pt.description}</p>
      </div>
    ))}
  </div>
</aside>

<style>
  .ai-summary-box {
    background: linear-gradient(135deg, #ffffff 0%, var(--surface) 100%);
    border: 1px solid var(--secondary);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-md);
    padding: 1.75rem 2rem;
    margin: 2.5rem auto 3.5rem;
    max-width: 900px;
    box-shadow: 0 4px 20px rgba(157, 70, 126, 0.06);
  }

  .summary-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .summary-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .summary-badge svg {
    color: var(--primary);
  }

  .summary-title {
    font-size: 1.15rem;
    color: var(--text-color);
    margin: 0;
    font-family: inherit;
    font-weight: 700;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.75rem;
  }

  @media (max-width: 680px) {
    .summary-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
    .ai-summary-box {
      padding: 1.25rem;
    }
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .summary-term {
    font-size: 0.9rem;
    color: var(--primary-dark);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .summary-term svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .summary-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    padding-left: 1.4rem;
  }
</style>
