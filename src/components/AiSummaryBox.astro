---
interface Props {
  title?: string;
  badge?: string;
  points: {
    term: string;
    description: string;
  }[];
}

const { 
  title = "Kernpunten van deze pagina", 
  badge = "Overzicht", 
  points = [] 
} = Astro.props;
---

<aside class="ai-summary-box" aria-label="Overzicht en kernpunten">
  <div class="summary-header">
    <span class="summary-badge">{badge}</span>
    <h3 class="summary-title">{title}</h3>
  </div>

  <div class="summary-grid">
    {points.map((pt) => (
      <div class="summary-item">
        <strong class="summary-term">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {pt.term}
        </strong>
        <p class="summary-desc" set:html={pt.description} />
      </div>
    ))}
  </div>
</aside>

<style>
  .ai-summary-box {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    margin: 2.5rem auto 3.5rem;
    max-width: 920px;
    box-shadow: var(--shadow-sm);
  }

  .summary-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .summary-badge {
    display: inline-block;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .summary-title {
    font-size: 1.2rem;
    color: var(--text-color);
    margin: 0;
    font-family: inherit;
    font-weight: 700;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 2rem;
  }

  @media (max-width: 680px) {
    .summary-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .ai-summary-box {
      padding: 1.5rem;
    }
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .summary-term {
    font-size: 0.925rem;
    color: var(--primary-dark);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .summary-term svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .summary-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    padding-left: 1.4rem;
  }
</style>
