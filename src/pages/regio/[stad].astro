---
import Layout from '../../layouts/Layout.astro';
import siteConfig from '../../../public/site-config.json';
import TreatmentCard from '../../components/TreatmentCard.astro';
import ReviewsCarousel from '../../components/ReviewsCarousel.astro';
import FAQSection from '../../components/FAQSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import AiSummaryBox from '../../components/AiSummaryBox.astro';

export function getStaticPaths() {
  return siteConfig.regions.map((reg) => ({
    params: { stad: reg.slug },
    props: { region: reg }
  }));
}

const { region } = Astro.props;

const waMessage = encodeURIComponent(`Hallo Alianne, ik woon in ${region.name} en wil graag een afspraak maken bij Massage Studio Eelde.`);

const regionSummary = [
  { term: `Reistijd vanaf ${region.name}`, description: `Slechts ${region.distance} naar Nieuwe Akkers 18a Eelde (gratis parkeren voor de deur).` },
  { term: "Beroepserkenning", description: "Alianne Zuidhof-Hoiting is erkend BATC Complementair Therapeut (HBO-conform) & NAP." },
  { term: "Vergoeding Zorgverzekering", description: "Therapeutische consulten (Shiatsu, Dorn, Voetreflex, Litteken) deels vergoedbaar." },
  { term: "Afspraak & Contact", description: "Eenvoudig afspreken via WhatsApp (06-23560803) of via het contactformulier." }
];

const regionTreatments = [
  {
    title: `Shiatsu Therapie & Massage voor inwoners van ${region.name}`,
    duration: "50 of 75 min",
    price: "Vanaf €80,-",
    image: "/images/DSC_1450.jpg",
    slug: "/behandelingen#shiatsu",
    description: `Japanse drukpunttherapie en meridiaanbehandeling voor diepe ontspanning en verlichting van spierspanning, hoofdpijn en stress (BATC vergoedbaar).`,
    tags: ["BATC Vergoedbaar", "Meridianen"]
  },
  {
    title: `Dorn Methode & Wervelkolomcorrectie regio ${region.name}`,
    duration: "50 min",
    price: "€80,-",
    image: "/images/DSC_1502.1.jpg",
    slug: "/behandelingen#dorn",
    description: `Zachte correctie van beenlengteverschil, bekkenscheefstand en rugklachten in dynamische beweging zonder te kraken.`,
    tags: ["BATC Vergoedbaar", "Zacht & Veilig"]
  },
  {
    title: `Voetreflexologie & Lymfedrainage ${region.name}`,
    duration: "50 min",
    price: "€80,-",
    image: "/images/DSC_1465.jpg",
    slug: "/behandelingen#voetreflex",
    description: `Reflexzonebehandeling op de voeten ter stimulatie van orgaanfuncties, spijsvertering en afvoer van afvalstoffen.`,
    tags: ["BATC Vergoedbaar", "Reflexzones"]
  },
  {
    title: `Littekenbehandeling nabij ${region.name}`,
    duration: "50 min",
    price: "€80,-",
    image: "/images/Handenbeen.jpg",
    slug: "/behandelingen#litteken",
    description: `Zachte bindweefseltechnieken om verkleefde, pijnlijke littekens soepel te maken en de doorbloeding te herstellen.`,
    tags: ["BATC Vergoedbaar", "Herstelweefsel"]
  },
  {
    title: `Oorreflexologie regio ${region.name}`,
    duration: "50 min",
    price: "€80,-",
    image: "/images/Oorreflexologie.png",
    slug: "/behandelingen#oorreflexologie",
    description: `Gerichte acupressuur op de oorschelp voor acute pijndemping, zenuwstelselregulatie en diepe ontspanning.`,
    tags: ["Pijndemping", "Zenuwstelsel"]
  },
  {
    title: `BIOSLIMMING Body Wrap Eelde (nabij ${region.name})`,
    duration: "60 of 90 min",
    price: "Vanaf €108,-",
    image: "/images/Bioslimming.jpg",
    slug: "/behandelingen#bioslimming",
    description: `100% natuurlijke Multi-Award winnende body wrap voor vetverbranding, huidversteviging en cellulitisvermindering. (Let op: niet-vergoed).`,
    tags: ["100% Natuurlijk", "Niet-vergoed"]
  }
];
---

<Layout 
  title={`Massage ${region.name} | Shiatsu, Dorn & Reflextherapie | Massage Studio Eelde`}
  description={`Zoekt u een professionele massagetherapeut nabij ${region.name}? Massage Studio Eelde ligt op slechts ${region.distance}. Erkend BATC therapeut Alianne Zuidhof-Hoiting.`}
>
  <!-- Hero Section -->
  <div class="page-hero">
    <div class="container text-center">
      <span class="section-badge">Werkgebied & Regio</span>
      <h1 class="page-title">Massage & Natuurgeneeskunde voor {region.name}</h1>
      <p class="page-lead">
        Op zoek naar een deskundige massage of therapeutisch consult in de omgeving van <strong>{region.name}</strong>? Onze sfeervolle praktijk in Eelde ligt op slechts <strong>{region.distance}</strong> en biedt volop gratis parkeergelegenheid.
      </p>
    </div>
  </div>

  <div class="container">
    <AiSummaryBox points={regionSummary} title={`Praktijkinformatie voor ${region.name}`} />
  </div>

  <!-- Introductie & Nabijheid -->
  <section class="section-py">
    <div class="container">
      <div class="region-intro-grid">
        <div class="region-text">
          <span class="section-badge">Dichtbij & Persoonlijk</span>
          <h2 class="section-title">Persoonlijke Massagetherapie Nabij {region.name}</h2>
          <p>
            Voor inwoners van <strong>{region.name}</strong> is Massage Studio Eelde dé aangewezen praktijk voor diepe ontspanning en gerichte klachtenbehandeling. Of u nu kampt met spanning in nek en schouders, rugklachten, vermoeidheid of simpelweg verlangt naar een oase van rust: bij erkend BATC Complementair Therapeut <strong>Alianne Zuidhof-Hoiting</strong> bent u in deskundige handen.
          </p>
          <p>
            Dankzij de centrale ligging aan de Nieuwe Akkers 18a in Eelde (in het voormalig kerkgebouw waar tevens <strong>Schoonheidssalon Mài Beauty</strong> en <strong>Fysiotherapie Noorderstee</strong> gevestigd zijn) is de praktijk vanuit {region.name} snel en eenvoudig bereikbaar.
          </p>

          <div class="region-perks">
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Korte reistijd:</strong> Slechts {region.distance} vanaf {region.name}</span>
            </div>
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Vergoeding:</strong> Therapeutische consulten deels vergoed via aanvullende verzekering</span>
            </div>
            <div class="perk-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Parkeren:</strong> Gratis en gemakkelijk parkeren voor de deur (fietsen graag buiten het hek)</span>
            </div>
          </div>

          <div class="region-cta-btns">
            <a href={`https://wa.me/${siteConfig.whatsapp}?text=${waMessage}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Afspraak via WhatsApp
            </a>
            <a href="/contact" class="btn btn-secondary">
              Route & Contact
            </a>
          </div>
        </div>

        <div class="region-visual">
          <div class="blob-frame">
            <img src="/images/Alianne.webp" alt={`Alianne Zuidhof-Hoiting - Massage Studio Eelde voor cliënten uit ${region.name}`} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Behandelingen Grid -->
  <section class="section-py bg-surface">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Behandelingen voor {region.name}</span>
        <h2 class="section-title">Populaire Behandelingen in Onze Praktijk</h2>
        <p class="section-subtitle">
          Al onze behandelingen worden afgestemd op basis van de 5 natuurgerichte principes en een persoonlijke intake.
        </p>
      </div>

      <div class="grid-3">
        {regionTreatments.map((t) => (
          <TreatmentCard {...t} />
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <ReviewsCarousel />

  <!-- FAQ -->
  <FAQSection />

  <!-- Contact & Locatie -->
  <section class="section-py" id="contact">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-badge">Kom Langs</span>
        <h2 class="section-title">Maak een Afspraak vanuit {region.name}</h2>
        <p class="section-subtitle">
          Heeft u een vraag of wilt u een behandeling bespreken? Neem gerust contact op.
        </p>
      </div>

      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface) 0%, #ffffff 100%);
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    margin-bottom: 1rem;
  }

  .page-lead {
    max-width: 740px;
    margin: 0 auto;
    font-size: 1.15rem;
    color: var(--text-muted);
  }

  .region-intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .region-intro-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .region-perks {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 2rem 0;
    background: var(--surface);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-color);
  }

  .perk-item svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .region-cta-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .region-visual {
    max-width: 400px;
    margin: 0 auto;
  }
</style>
