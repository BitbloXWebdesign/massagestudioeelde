---
// Admin CMS pagina voor Massage Studio Eelde
// Beveiligd met wachtwoord (opgeslagen in Cloudflare Pages env: ADMIN_PASSWORD)
import Layout from '../../layouts/Layout.astro';
import siteConfig from '../../../public/site-config.json';
---

<Layout title="Admin — Massage Studio Eelde" description="Beheer je website inhoud" hideHeaderFooter={true}>

<!-- LOGIN GATE -->
<div id="loginGate" style="position:fixed;inset:0;z-index:999999;background:linear-gradient(135deg,#1a0a14 0%,#2d0a1e 100%);display:flex;align-items:center;justify-content:center;padding:20px;">
  <div style="max-width:420px;width:100%;padding:44px 36px;background:rgba(255,255,255,0.05);border:1px solid rgba(157,70,126,0.4);border-radius:20px;text-align:center;backdrop-filter:blur(20px);">
    <div style="width:64px;height:64px;background:rgba(157,70,126,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:1.8rem;">🌸</div>
    <h2 style="color:#fff;font-size:1.4rem;margin-bottom:6px;">Massage Studio Eelde</h2>
    <p style="color:rgba(255,255,255,0.5);font-size:0.88rem;margin-bottom:28px;">Website Beheer</p>
    <div style="display:flex;flex-direction:column;gap:12px;">
      <input type="password" id="passInput" placeholder="Wachtwoord" autocomplete="current-password"
        style="width:100%;padding:14px 18px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:12px;color:#fff;font-size:1rem;text-align:center;letter-spacing:3px;box-sizing:border-box;" />
      <button id="loginBtn" style="width:100%;padding:14px;background:#9d467e;color:#fff;border:none;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;transition:background 0.2s;">
        Inloggen →
      </button>
      <p id="loginErr" style="color:#f87171;font-size:0.85rem;margin:0;display:none;">⚠️ Onjuist wachtwoord</p>
    </div>
  </div>
</div>

<!-- ADMIN DASHBOARD -->
<div id="adminDash" style="display:none;min-height:100vh;background:#0f0a0d;color:#e2e8f0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">

  <!-- TOPBAR -->
  <header style="background:#1a0f16;border-bottom:1px solid rgba(157,70,126,0.3);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;">
    <div style="display:flex;align-items:center;gap:14px;">
      <span style="font-size:1.5rem;">🌸</span>
      <div>
        <div style="font-size:0.95rem;font-weight:700;color:#fff;">Massage Studio Eelde</div>
        <div style="font-size:0.75rem;color:rgba(255,255,255,0.4);">Website Beheerder</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="https://massagestudioeelde.nl" target="_blank" style="font-size:0.84rem;color:#9d467e;text-decoration:none;border:1px solid rgba(157,70,126,0.4);padding:7px 14px;border-radius:8px;">🌐 Live Site ↗</a>
      <button id="logoutBtn" style="font-size:0.84rem;color:rgba(255,255,255,0.5);background:transparent;border:1px solid rgba(255,255,255,0.1);padding:7px 14px;border-radius:8px;cursor:pointer;">Uitloggen</button>
    </div>
  </header>

  <!-- SAVE TOAST -->
  <div id="saveToast" style="position:fixed;top:80px;right:24px;z-index:9999;background:#16a34a;color:#fff;padding:12px 20px;border-radius:10px;font-weight:600;font-size:0.9rem;display:none;box-shadow:0 8px 24px rgba(0,0,0,0.4);">
    ✅ Opgeslagen! Wijziging is live.
  </div>
  <div id="errToast" style="position:fixed;top:80px;right:24px;z-index:9999;background:#dc2626;color:#fff;padding:12px 20px;border-radius:10px;font-weight:600;font-size:0.9rem;display:none;box-shadow:0 8px 24px rgba(0,0,0,0.4);">
    ❌ Fout bij opslaan. Probeer opnieuw.
  </div>

  <div style="max-width:1000px;margin:0 auto;padding:32px 24px;">

    <!-- TABS -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px;border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:16px;">
      {['hero','over','behandelingen','openingstijden','contact','fotos','backup'].map((tab, i) => (
        <button class="tab-btn" data-tab={tab}
          style={`padding:9px 18px;border-radius:8px;border:none;cursor:pointer;font-size:0.88rem;font-weight:600;transition:all 0.2s;${i===0?'background:#9d467e;color:#fff;':'background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.6);'}`}>
          {tab === 'hero' ? '🏠 Hero' : tab === 'over' ? '👩 Over Mij' : tab === 'behandelingen' ? '💆 Behandelingen' : tab === 'openingstijden' ? '🕐 Openingstijden' : tab === 'contact' ? '📞 Contact' : tab === 'fotos' ? '📸 Foto\'s' : '🔒 Backup'}
        </button>
      ))}
    </div>

    <!-- ===== TAB: HERO ===== -->
    <div id="tab-hero" class="tab-pane">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:24px;">🏠 Hero Sectie</h2>
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div class="field-card">
          <label class="field-label">Hoofdtitel (H1)</label>
          <input type="text" id="f_hero_title" class="field-input" placeholder="Massage Studio Eelde — Uw Welzijn, Onze Passie" />
          <span class="field-hint">De grote titel bovenaan de homepage</span>
        </div>
        <div class="field-card">
          <label class="field-label">Subtitel / Introductietekst</label>
          <textarea id="f_hero_subtitle" class="field-textarea" rows="3" placeholder="Ontdek de kracht van holistische massagetherapie..."></textarea>
        </div>
        <div class="field-card">
          <label class="field-label">Knoptekst (CTA)</label>
          <input type="text" id="f_hero_cta_text" class="field-input" placeholder="Maak een afspraak" />
        </div>
        <div class="field-card">
          <label class="field-label">Tagline (onder logo / header)</label>
          <input type="text" id="f_tagline" class="field-input" placeholder="Waar kwaliteit en gevoel voorop staan" />
        </div>
        <button class="save-btn" onclick="saveSection(['hero_title','hero_subtitle','hero_cta_text','tagline'])">💾 Hero opslaan</button>
      </div>
    </div>

    <!-- ===== TAB: OVER MIJ ===== -->
    <div id="tab-over" class="tab-pane" style="display:none;">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:24px;">👩 Over Mij Sectie</h2>
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div class="field-card">
          <label class="field-label">Titel van de sectie</label>
          <input type="text" id="f_over_mij_title" class="field-input" placeholder="Over Alianne" />
        </div>
        <div class="field-card">
          <label class="field-label">Tekst Over Mij</label>
          <textarea id="f_over_mij_text" class="field-textarea" rows="8" placeholder="Uw verhaal..."></textarea>
          <span class="field-hint">Alinea's worden gescheiden door een lege regel</span>
        </div>
        <button class="save-btn" onclick="saveSection(['over_mij_title','over_mij_text'])">💾 Over Mij opslaan</button>
      </div>
    </div>

    <!-- ===== TAB: BEHANDELINGEN ===== -->
    <div id="tab-behandelingen" class="tab-pane" style="display:none;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
        <h2 style="color:#fff;font-size:1.2rem;margin:0;">💆 Behandelingen</h2>
        <button onclick="addBehandeling()" style="background:#9d467e;color:#fff;border:none;padding:9px 18px;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.88rem;">+ Behandeling Toevoegen</button>
      </div>
      <div id="behandelingenList" style="display:flex;flex-direction:column;gap:16px;"></div>
      <div style="margin-top:24px;">
        <button class="save-btn" onclick="saveBehandelingen()">💾 Alle behandelingen opslaan</button>
      </div>
    </div>

    <!-- ===== TAB: OPENINGSTIJDEN ===== -->
    <div id="tab-openingstijden" class="tab-pane" style="display:none;">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:24px;">🕐 Openingstijden</h2>
      <div id="hoursGrid" style="display:flex;flex-direction:column;gap:12px;"></div>
      <div style="margin-top:20px;">
        <div class="field-card">
          <label class="field-label">Voetnoot / Opmerking</label>
          <input type="text" id="f_hours_note" class="field-input" placeholder="* In uitzonderlijke gevallen valt er te overleggen." />
        </div>
      </div>
      <button class="save-btn" onclick="saveOpeningstijden()" style="margin-top:20px;">💾 Openingstijden opslaan</button>
    </div>

    <!-- ===== TAB: CONTACT ===== -->
    <div id="tab-contact" class="tab-pane" style="display:none;">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:24px;">📞 Contactgegevens</h2>
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div class="field-card">
          <label class="field-label">Telefoonnummer (voor bellen)</label>
          <input type="text" id="f_phone" class="field-input" placeholder="+31623560803" />
          <span class="field-hint">Inclusief landcode, bv. +31623560803</span>
        </div>
        <div class="field-card">
          <label class="field-label">Telefoonnummer (weergave)</label>
          <input type="text" id="f_phone_formatted" class="field-input" placeholder="06 - 23 56 08 03" />
          <span class="field-hint">Hoe het nummer op de site te zien is</span>
        </div>
        <div class="field-card">
          <label class="field-label">E-mailadres</label>
          <input type="email" id="f_email" class="field-input" placeholder="info@massagestudioeelde.nl" />
        </div>
        <div class="field-card">
          <label class="field-label">Straat + huisnummer</label>
          <input type="text" id="f_street" class="field-input" placeholder="Nieuwe Akkers 18a" />
        </div>
        <div class="field-card">
          <label class="field-label">Postcode + Stad</label>
          <input type="text" id="f_city" class="field-input" placeholder="9765 GC Eelde-Paterswolde" />
        </div>
        <button class="save-btn" onclick="saveSection(['phone','phone_formatted','email','street','city'])">💾 Contactgegevens opslaan</button>
      </div>
    </div>

    <!-- ===== TAB: FOTO'S ===== -->
    <div id="tab-fotos" class="tab-pane" style="display:none;">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:24px;">📸 Foto's Vervangen</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">

        <!-- Hero Foto -->
        <div class="field-card">
          <label class="field-label">Hero Achtergrond / Hoofdfoto</label>
          <div id="hero_image_preview" style="width:100%;height:160px;background:rgba(255,255,255,0.05);border-radius:8px;overflow:hidden;margin-bottom:12px;display:flex;align-items:center;justify-content:center;">
            <span style="color:rgba(255,255,255,0.3);font-size:0.85rem;">Geen aangepaste afbeelding</span>
          </div>
          <input type="file" id="hero_image_upload" accept="image/*" style="display:none;" onchange="previewAndUpload(this,'hero_image','hero_image_preview')" />
          <button onclick="document.getElementById('hero_image_upload').click()" style="width:100%;padding:10px;background:rgba(157,70,126,0.2);color:#9d467e;border:1px dashed rgba(157,70,126,0.5);border-radius:8px;cursor:pointer;font-weight:600;font-size:0.88rem;">
            📁 Kies nieuwe foto
          </button>
          <span class="field-hint">Max 5MB. JPG, PNG of WebP aanbevolen.</span>
        </div>

        <!-- Profiel Foto -->
        <div class="field-card">
          <label class="field-label">Profielfoto (Over Mij)</label>
          <div id="profile_image_preview" style="width:100%;height:160px;background:rgba(255,255,255,0.05);border-radius:8px;overflow:hidden;margin-bottom:12px;display:flex;align-items:center;justify-content:center;">
            <span style="color:rgba(255,255,255,0.3);font-size:0.85rem;">Geen aangepaste afbeelding</span>
          </div>
          <input type="file" id="profile_image_upload" accept="image/*" style="display:none;" onchange="previewAndUpload(this,'profile_image','profile_image_preview')" />
          <button onclick="document.getElementById('profile_image_upload').click()" style="width:100%;padding:10px;background:rgba(157,70,126,0.2);color:#9d467e;border:1px dashed rgba(157,70,126,0.5);border-radius:8px;cursor:pointer;font-weight:600;font-size:0.88rem;">
            📁 Kies nieuwe foto
          </button>
          <span class="field-hint">Portretfoto, bij voorkeur vierkant.</span>
        </div>

      </div>
      <p style="font-size:0.8rem;color:rgba(255,255,255,0.35);margin-top:20px;">⚡ Foto's worden direct na selectie opgeslagen en zijn meteen live.</p>
    </div>

    <!-- ===== TAB: BACKUP ===== -->
    <div id="tab-backup" class="tab-pane" style="display:none;">
      <h2 style="color:#fff;font-size:1.2rem;margin-bottom:8px;">🔒 Backup & Herstel</h2>
      <p style="color:rgba(255,255,255,0.45);font-size:0.88rem;margin-bottom:28px;">Exporteer alle inhoud als JSON bestand of herstel vanuit een eerder gemaakte backup.</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">

        <!-- Download backup -->
        <div class="field-card">
          <div style="font-size:2rem;margin-bottom:12px;">📥</div>
          <h3 style="color:#fff;font-size:1rem;margin:0 0 8px;">Backup Downloaden</h3>
          <p style="color:rgba(255,255,255,0.45);font-size:0.84rem;line-height:1.6;margin:0 0 16px;">Download alle website-inhoud als JSON bestand. Sla dit op als noodkopie op je computer of USB-stick.</p>
          <button onclick="downloadBackup()" class="save-btn" style="background:#1d4ed8;">
            📥 Download Backup (.json)
          </button>
          <p id="backupDownloadStatus" style="margin-top:10px;font-size:0.82rem;color:#4ade80;display:none;"></p>
        </div>

        <!-- Terugzetten vanuit bestand -->
        <div class="field-card">
          <div style="font-size:2rem;margin-bottom:12px;">📤</div>
          <h3 style="color:#fff;font-size:1rem;margin:0 0 8px;">Backup Terugzetten</h3>
          <p style="color:rgba(255,255,255,0.45);font-size:0.84rem;line-height:1.6;margin:0 0 16px;">Herstel alle inhoud vanuit een eerder gedownload .json backup bestand.</p>
          <input type="file" id="restoreFileInput" accept=".json" style="display:none;" onchange="restoreFromFile(this)" />
          <button onclick="document.getElementById('restoreFileInput').click()" class="save-btn" style="background:#b45309;">
            📤 Kies Backup Bestand
          </button>
          <p id="restoreStatus" style="margin-top:10px;font-size:0.82rem;color:#4ade80;display:none;"></p>
        </div>

        <!-- GitHub auto-backup -->
        <div class="field-card">
          <div style="font-size:2rem;margin-bottom:12px;">☁️</div>
          <h3 style="color:#fff;font-size:1rem;margin:0 0 8px;">Backup naar GitHub</h3>
          <p style="color:rgba(255,255,255,0.45);font-size:0.84rem;line-height:1.6;margin:0 0 16px;">Sla een backup op in de GitHub repository. Dit gebeurt automatisch elke nacht, maar je kunt het ook handmatig starten.</p>
          <button onclick="triggerGithubBackup()" class="save-btn" style="background:#16a34a;">
            ☁️ Nu Backup naar GitHub
          </button>
          <p id="githubBackupStatus" style="margin-top:10px;font-size:0.82rem;color:#4ade80;display:none;"></p>
        </div>

      </div>

      <!-- Info box -->
      <div style="margin-top:28px;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.25);border-radius:12px;padding:20px;">
        <h4 style="color:#60a5fa;margin:0 0 10px;font-size:0.9rem;">ℹ️ Hoe werkt het backup systeem?</h4>
        <ul style="color:rgba(255,255,255,0.5);font-size:0.84rem;line-height:2;margin:0;padding-left:18px;">
          <li>Alle aanpassingen worden opgeslagen in Cloudflare KV (een aparte database)</li>
          <li>De GitHub repository bevat de code — die staat altijd veilig op GitHub</li>
          <li>De backup in GitHub (<code style="background:rgba(255,255,255,0.08);padding:1px 6px;border-radius:4px;">data/kv-backup.json</code>) wordt elke nacht automatisch bijgewerkt</li>
          <li>Als er ooit iets misgaat: download een backup → herstel met 'Backup Terugzetten'</li>
        </ul>
      </div>
    </div>

  </div><!-- /container -->
</div><!-- /adminDash -->

<style>
  .tab-pane { animation: fadeIn 0.2s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .field-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 20px;
  }
  .field-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .field-input {
    width: 100%;
    padding: 12px 14px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    color: #fff;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .field-input:focus { outline: none; border-color: #9d467e; }
  .field-textarea {
    width: 100%;
    padding: 12px 14px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    color: #fff;
    font-size: 0.95rem;
    box-sizing: border-box;
    resize: vertical;
    font-family: inherit;
    line-height: 1.6;
    transition: border-color 0.2s;
  }
  .field-textarea:focus { outline: none; border-color: #9d467e; }
  .field-hint {
    display: block;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.35);
    margin-top: 7px;
  }
  .save-btn {
    background: #9d467e;
    color: #fff;
    border: none;
    padding: 13px 28px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    width: 100%;
  }
  .save-btn:hover { background: #7a2b60; }

  .behandeling-card {
    background: rgba(157,70,126,0.06);
    border: 1px solid rgba(157,70,126,0.2);
    border-radius: 12px;
    padding: 20px;
    position: relative;
  }
  .hour-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 12px;
    align-items: center;
  }
</style>

<script>
  // ---- GLOBAL STATE ----
  let adminPass = '';
  let behandelingen: any[] = [];
  let openingHours: any[] = [];

  // Default behandelingen uit site (as fallback)
  const defaultBehandelingen = [
    { id: 'shiatsu', title: 'Shiatsu Therapie & Massage', tagline: 'Traditionele Japanse drukpuntmassage', duration: '50 of 75 minuten', price: '€80,- (50 min) / €125,- (75 min)', reimbursement: 'Deels vergoedbaar', reimbursementType: 'covered' },
    { id: 'dorn', title: 'Dorn-Methode', tagline: 'Milde correctie van wervelkolom', duration: '50 minuten', price: '€80,-', reimbursement: 'Deels vergoedbaar', reimbursementType: 'covered' },
    { id: 'voetreflex', title: 'Voetreflextherapie', tagline: 'Stimulatie via de voeten', duration: '50 minuten', price: '€80,-', reimbursement: 'Deels vergoedbaar', reimbursementType: 'covered' },
    { id: 'ontspanning', title: 'Ontspanningsmassage', tagline: 'Klassieke Zweedse massage', duration: '50 of 75 minuten', price: '€80,- / €120,-', reimbursement: 'Niet vergoedbaar', reimbursementType: 'not-covered' },
  ];

  const defaultHours = [
    { day: 'Maandag', hours: '09:00 - 18:00' },
    { day: 'Dinsdag', hours: 'Gesloten' },
    { day: 'Woensdag', hours: '09:00 - 18:00' },
    { day: 'Donderdag', hours: 'Gesloten' },
    { day: 'Vrijdag', hours: '09:00 - 18:00' },
    { day: 'Zaterdag & Zondag', hours: 'Gesloten*' },
  ];

  // ---- LOGIN ----
  document.getElementById('loginBtn')!.addEventListener('click', doLogin);
  document.getElementById('passInput')!.addEventListener('keydown', (e: any) => { if (e.key === 'Enter') doLogin(); });

  async function doLogin() {
    const pass = (document.getElementById('passInput') as HTMLInputElement).value;
    // Test wachtwoord via API
    const res = await fetch('/api/content', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pass, key: '__ping__', value: 'ok' })
    });
    const data = await res.json();
    if (data.success) {
      adminPass = pass;
      document.getElementById('loginGate')!.style.display = 'none';
      document.getElementById('adminDash')!.style.display = 'block';
      loadAllContent();
    } else {
      document.getElementById('loginErr')!.style.display = 'block';
    }
  }

  document.getElementById('logoutBtn')!.addEventListener('click', () => {
    adminPass = '';
    document.getElementById('loginGate')!.style.display = 'flex';
    document.getElementById('adminDash')!.style.display = 'none';
    (document.getElementById('passInput') as HTMLInputElement).value = '';
  });

  // ---- TABS ----
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab!;
      document.querySelectorAll('.tab-pane').forEach(p => (p as HTMLElement).style.display = 'none');
      document.querySelectorAll('.tab-btn').forEach(b => {
        (b as HTMLElement).style.background = 'rgba(255,255,255,0.06)';
        (b as HTMLElement).style.color = 'rgba(255,255,255,0.6)';
      });
      document.getElementById('tab-' + tab)!.style.display = 'block';
      (btn as HTMLElement).style.background = '#9d467e';
      (btn as HTMLElement).style.color = '#fff';
    });
  });

  // ---- LOAD ALL CONTENT FROM KV ----
  async function loadAllContent() {
    const res = await fetch('/api/content?all=true');
    const data = await res.json();
    const c = data.data || {};

    // Hero
    setVal('f_hero_title', c.hero_title || '');
    setVal('f_hero_subtitle', c.hero_subtitle || '');
    setVal('f_hero_cta_text', c.hero_cta_text || '');
    setVal('f_tagline', c.tagline || '');

    // Over mij
    setVal('f_over_mij_title', c.over_mij_title || '');
    setVal('f_over_mij_text', c.over_mij_text || '');

    // Contact
    setVal('f_phone', c.phone || '');
    setVal('f_phone_formatted', c.phone_formatted || '');
    setVal('f_email', c.email || '');
    setVal('f_street', c.street || '');
    setVal('f_city', c.city || '');

    // Behandelingen
    behandelingen = c.behandelingen || defaultBehandelingen;
    renderBehandelingen();

    // Openingstijden
    openingHours = c.opening_hours || defaultHours;
    setVal('f_hours_note', c.opening_hours_note || '* In uitzonderlijke gevallen valt er te overleggen.');
    renderOpeningstijden();

    // Foto previews
    if (c.hero_image) showImagePreview('hero_image_preview', c.hero_image);
    if (c.profile_image) showImagePreview('profile_image_preview', c.profile_image);
  }

  function setVal(id: string, val: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
    if (el) el.value = val;
  }

  // ---- SAVE SECTION ----
  async function saveSection(keys: string[]) {
    const bulk: Record<string, string> = {};
    for (const key of keys) {
      const el = document.getElementById('f_' + key) as HTMLInputElement | HTMLTextAreaElement;
      if (el) bulk[key] = el.value;
    }
    await saveToKV(bulk);
  }
  (window as any).saveSection = saveSection;

  // ---- BEHANDELINGEN ----
  function renderBehandelingen() {
    const container = document.getElementById('behandelingenList')!;
    container.innerHTML = '';
    behandelingen.forEach((b, i) => {
      const card = document.createElement('div');
      card.className = 'behandeling-card';
      card.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <strong style="color:#fff;font-size:0.95rem;">${b.title || 'Nieuwe behandeling'}</strong>
          <div style="display:flex;gap:8px;">
            <button onclick="moveBehandeling(${i},-1)" style="background:rgba(255,255,255,0.06);border:none;color:#fff;padding:5px 10px;border-radius:6px;cursor:pointer;">↑</button>
            <button onclick="moveBehandeling(${i},1)" style="background:rgba(255,255,255,0.06);border:none;color:#fff;padding:5px 10px;border-radius:6px;cursor:pointer;">↓</button>
            <button onclick="removeBehandeling(${i})" style="background:rgba(220,38,38,0.2);border:1px solid rgba(220,38,38,0.3);color:#f87171;padding:5px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">Verwijderen</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label class="field-label">Naam behandeling</label>
            <input class="field-input" value="${esc(b.title)}" oninput="updateBehandeling(${i},'title',this.value)" placeholder="bv. Shiatsu Massage" />
          </div>
          <div>
            <label class="field-label">Korte omschrijving</label>
            <input class="field-input" value="${esc(b.tagline)}" oninput="updateBehandeling(${i},'tagline',this.value)" placeholder="bv. Diepe ontspanning" />
          </div>
          <div>
            <label class="field-label">Duur</label>
            <input class="field-input" value="${esc(b.duration)}" oninput="updateBehandeling(${i},'duration',this.value)" placeholder="bv. 50 minuten" />
          </div>
          <div>
            <label class="field-label">Prijs</label>
            <input class="field-input" value="${esc(b.price)}" oninput="updateBehandeling(${i},'price',this.value)" placeholder="bv. €80,-" />
          </div>
          <div>
            <label class="field-label">Vergoeding</label>
            <input class="field-input" value="${esc(b.reimbursement)}" oninput="updateBehandeling(${i},'reimbursement',this.value)" placeholder="bv. Deels vergoedbaar" />
          </div>
          <div>
            <label class="field-label">Vergoeding type</label>
            <select class="field-input" onchange="updateBehandeling(${i},'reimbursementType',this.value)">
              <option value="covered" ${b.reimbursementType==='covered'?'selected':''}>Vergoedbaar (groen)</option>
              <option value="not-covered" ${b.reimbursementType==='not-covered'?'selected':''}>Niet vergoedbaar (grijs)</option>
              <option value="partial" ${b.reimbursementType==='partial'?'selected':''}>Deels vergoedbaar (oranje)</option>
            </select>
          </div>
        </div>
        <div style="margin-top:12px;">
          <label class="field-label">Uitgebreide beschrijving</label>
          <textarea class="field-textarea" rows="4" oninput="updateBehandeling(${i},'content',this.value)" placeholder="Beschrijf de behandeling...">${esc(b.content || '')}</textarea>
        </div>
      `;
      container.appendChild(card);
    });
  }

  function esc(s: string) { return (s || '').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }

  (window as any).addBehandeling = () => {
    behandelingen.push({ id: 'nieuw_' + Date.now(), title: '', tagline: '', duration: '50 minuten', price: '', reimbursement: 'Niet vergoedbaar', reimbursementType: 'not-covered', content: '' });
    renderBehandelingen();
  };
  (window as any).removeBehandeling = (i: number) => {
    if (confirm('Deze behandeling verwijderen?')) { behandelingen.splice(i, 1); renderBehandelingen(); }
  };
  (window as any).moveBehandeling = (i: number, dir: number) => {
    const j = i + dir;
    if (j < 0 || j >= behandelingen.length) return;
    [behandelingen[i], behandelingen[j]] = [behandelingen[j], behandelingen[i]];
    renderBehandelingen();
  };
  (window as any).updateBehandeling = (i: number, field: string, val: string) => {
    behandelingen[i][field] = val;
  };
  (window as any).saveBehandelingen = () => saveToKV({ behandelingen: JSON.stringify(behandelingen) });

  // ---- OPENINGSTIJDEN ----
  function renderOpeningstijden() {
    const grid = document.getElementById('hoursGrid')!;
    grid.innerHTML = '';
    openingHours.forEach((row, i) => {
      const div = document.createElement('div');
      div.className = 'hour-row';
      div.innerHTML = `
        <input class="field-input" value="${esc(row.day)}" oninput="openingHours[${i}].day=this.value" placeholder="Dag" />
        <input class="field-input" value="${esc(row.hours)}" oninput="openingHours[${i}].hours=this.value" placeholder="bv. 09:00 - 18:00 of Gesloten" />
      `;
      grid.appendChild(div);
    });
  }
  (window as any).saveOpeningstijden = () => saveToKV({
    opening_hours: JSON.stringify(openingHours),
    opening_hours_note: (document.getElementById('f_hours_note') as HTMLInputElement).value
  });

  // ---- FOTO UPLOAD ----
  (window as any).previewAndUpload = (input: HTMLInputElement, key: string, previewId: string) => {
    const file = input.files?.[0];
    if (!file) return;

    // Client-side resize to max 1200px width for storage efficiency
    const reader = new FileReader();
    reader.onload = async (e) => {
      const dataUrl = e.target?.result as string;

      // Resize via canvas
      const img = new Image();
      img.onload = async () => {
        const maxW = 1200;
        const scale = img.width > maxW ? maxW / img.width : 1;
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const resized = canvas.toDataURL('image/jpeg', 0.85);

        // Show preview
        showImagePreview(previewId, resized);

        // Upload to KV
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: adminPass, imageKey: key, imageData: resized })
        });
        const data = await res.json();
        if (data.success) showToast('save');
        else showToast('err');
      };
      img.src = dataUrl;
    };
    reader.readAsDataURL(file);
  };

  function showImagePreview(previewId: string, src: string) {
    const preview = document.getElementById(previewId)!;
    preview.innerHTML = `<img src="${src}" style="width:100%;height:100%;object-fit:cover;" alt="Preview" />`;
  }

  // ---- KV SAVE ----
  async function saveToKV(bulk: Record<string, any>) {
    const res = await fetch('/api/content', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: adminPass, bulk })
    });
    const data = await res.json();
    if (data.success) showToast('save');
    else showToast('err');
  }

  function showToast(type: 'save' | 'err') {
    const id = type === 'save' ? 'saveToast' : 'errToast';
    const el = document.getElementById(id)!;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 3000);
  }

  // ---- BACKUP FUNCTIES ----

  // Download alle KV content als JSON bestand
  (window as any).downloadBackup = async () => {
    const statusEl = document.getElementById('backupDownloadStatus')!;
    statusEl.style.display = 'block';
    statusEl.style.color = '#94a3b8';
    statusEl.textContent = '⏳ Backup ophalen...';

    const res = await fetch(`/api/backup-export?password=${encodeURIComponent(adminPass)}`);
    if (!res.ok) {
      statusEl.style.color = '#f87171';
      statusEl.textContent = '❌ Fout bij ophalen backup';
      return;
    }

    const json = await res.text();
    const blob = new Blob([json], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `mse-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);

    statusEl.style.color = '#4ade80';
    statusEl.textContent = '✅ Backup gedownload!';
  };

  // Herstel KV content vanuit een JSON backup bestand
  (window as any).restoreFromFile = (input: HTMLInputElement) => {
    const file = input.files?.[0];
    if (!file) return;

    const statusEl = document.getElementById('restoreStatus')!;
    statusEl.style.display = 'block';
    statusEl.style.color = '#94a3b8';
    statusEl.textContent = '⏳ Bestand lezen...';

    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const backup = JSON.parse(e.target?.result as string);
        if (!backup.content) {
          statusEl.style.color = '#f87171';
          statusEl.textContent = '❌ Ongeldig backup bestand';
          return;
        }

        if (!confirm(`Weet je zeker dat je ${Object.keys(backup.content).length} onderdelen wilt terugzetten?\n\nDit overschrijft de huidige inhoud!`)) {
          statusEl.style.display = 'none';
          return;
        }

        statusEl.textContent = '⏳ Terugzetten...';
        const res = await fetch('/api/backup-import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: adminPass, backup })
        });
        const data = await res.json();

        if (data.success) {
          statusEl.style.color = '#4ade80';
          statusEl.textContent = `✅ ${data.message}`;
          // Herlaad content in de admin
          setTimeout(() => loadAllContent(), 1000);
        } else {
          statusEl.style.color = '#f87171';
          statusEl.textContent = `❌ ${data.error}`;
        }
      } catch (err) {
        statusEl.style.color = '#f87171';
        statusEl.textContent = '❌ Kan bestand niet lezen';
      }
    };
    reader.readAsText(file);
  };

  // Handmatige backup naar GitHub triggeren
  (window as any).triggerGithubBackup = async () => {
    const statusEl = document.getElementById('githubBackupStatus')!;
    statusEl.style.display = 'block';
    statusEl.style.color = '#94a3b8';
    statusEl.textContent = '⏳ Backup naar GitHub...';

    const res = await fetch(`/api/backup-github?password=${encodeURIComponent(adminPass)}`);
    const data = await res.json();

    if (data.success) {
      statusEl.style.color = '#4ade80';
      statusEl.textContent = `✅ Opgeslagen! ${data.keyCount} sleutels → GitHub`;
    } else {
      statusEl.style.color = '#f87171';
      statusEl.textContent = `❌ ${data.error || 'GitHub backup mislukt'}`;
    }
  };
</script>

</Layout>
